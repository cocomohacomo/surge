{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surge.invalid/schemas/surge-projector-output-v1.0.schema.json",
  "title": "SURGE Canonical Projector Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attributes",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "surge-projector-output-v1.0"
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attribute"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "phenomena": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "evidence_spans"
        ],
        "properties": {
          "label": {
            "enum": [
              "negation",
              "contradiction",
              "temporal_supersession",
              "ambiguity"
            ]
          },
          "evidence_spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidenceSpan"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "source": {
          "enum": [
            "context",
            "text"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "polarity",
        "category",
        "evidence_spans"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "polarity": {
          "enum": [
            "positive",
            "negative",
            "uncertain",
            "unknown"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "evidence_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceSpan"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "target",
        "evidence_spans"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "evidence_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceSpan"
          }
        }
      }
    }
  }
}
