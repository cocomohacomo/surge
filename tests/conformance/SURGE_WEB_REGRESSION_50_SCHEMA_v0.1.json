{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surge.local/schemas/SURGE_WEB_REGRESSION_50_SCHEMA_v0.1.json",
  "title": "SURGE Web-derived regression case set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "dataset_kind",
    "separation_from_scoring",
    "cases"
  ],
  "properties": {
    "dataset_id": {
      "const": "SURGE_WEB_REGRESSION_50_v0.1"
    },
    "dataset_kind": {
      "const": "web_document_regression"
    },
    "separation_from_scoring": {
      "const": "independent_from_SURGE_JA_SCORING_50_v0.1"
    },
    "cases": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "source_url",
          "publisher",
          "acquired_at",
          "capture_status",
          "source_digest",
          "source_excerpt",
          "expected_decision",
          "expected_claims",
          "expected_scopes"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^WEB-[0-9]{2}$"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "acquired_at": {
            "type": "string",
            "format": "date-time"
          },
          "capture_status": {
            "enum": [
              "FULL_TEXT",
              "PARTIAL",
              "PDF_TEXT"
            ]
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_excerpt": {
            "type": "string",
            "minLength": 1
          },
          "expected_decision": {
            "enum": [
              "ACCEPT",
              "REVIEW",
              "ABSTAIN"
            ]
          },
          "expected_claims": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "expected_scopes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "adjudication_note": {
            "type": "string"
          }
        }
      }
    }
  }
}\n